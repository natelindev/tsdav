{
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["ES2019", "dom", "DOM.Iterable"],
    "module": "preserve",
    "target": "ES2018",
    "declaration": true,
    "isolatedModules": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "env.d.ts", "rolldown.config.mjs"],
  "exclude": ["node_modules", "**/__tests__/**"]
}
