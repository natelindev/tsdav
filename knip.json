{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts!",
        "src/**/*.test.ts",
        "tests/**/*.ts",
        "scripts/*.{cjs,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignore": [
        "src/__tests__/integration/**"
      ],
      "ignoreDependencies": []
    },
    "docs": {
      "entry": [
        "astro.config.mjs",
        "src/**/*.{ts,tsx,astro}",
        "tests/*.test.cjs"
      ],
      "project": [
        "src/**/*.{ts,tsx,astro}",
        "src/content/docs/**/*.{md,mdx}"
      ],
      "ignoreDependencies": [
        "@astrojs/mdx",
        "npm"
      ]
    }
  }
}
